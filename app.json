{
  "expo": {
    "name": "Supreme",
    "slug": "supremeenergies",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/one.png",
    "userInterfaceStyle": "automatic",
     "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A1C23"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/one.png",
          "color": "#8E1C1C",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1C23"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "We need access to your photo library to attach images to projects.",
          "cameraPermission": "We need camera access to take photos for projects."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/one.png",
        "backgroundColor": "#00000000"
      },
      "package": "com.bobx47.supremeenergies",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "b0dd796e-ee34-43c3-9769-bb0a1ddf7500"
      }
    }
  }
}